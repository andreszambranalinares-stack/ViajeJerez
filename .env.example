# Copia este archivo a ".env" y rellena con los datos de tu proyecto de Supabase.
# Los encuentras en: Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Código secreto para hacerse administrador dentro de la app
# (verificar misiones, generar las misiones del día...). Cámbialo.
VITE_ADMIN_CODE=jerez
